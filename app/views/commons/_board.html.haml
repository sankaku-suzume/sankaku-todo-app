.board
  .board_header
    = link_to board_path(board) do
      .board_title
        = board.name
    - if user_signed_in? && current_user.has_written?(board)
      .board_actions
        .dropdown
          = image_tag 'actions.png', class: 'dropbtn'
          .dropdown-content.mini
            = link_to 'Edit', edit_board_path(board)
            = link_to 'Delete', board_path(board), data: {method: 'delete', confirm: 'Are you sure you want to delete this board?'}
  .board_content
    = board.description
  .board_detail
    = image_tag board.user.avatar_image