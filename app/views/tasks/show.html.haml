.container
  .page_header
    %h2.page_title= @task.name
    .page_actions
      .dropdown
        = image_tag 'actions.png', class: 'dropbtn'
        .dropdown-content.mini.gray
          = link_to 'Edit', edit_board_task_path(@task)
          = link_to 'Delete', board_task_path(@task), data: {method: 'delete', confirm: 'Are you sure you want to delete this task?'}
  .page_text
    %p.page_text-content= @task.description