.container
  %h2 New Board
  %ul
  = form_with(model: @board, local: true) do |f|
    .field
      = f.label :title, 'Name'
      %br/
      = f.text_field :title, class: 'text'
    .field
      = f.label :content, 'Description'
      %br/
      = f.text_area :content
    .actions
      = f.submit 'Submit', class: 'btn-primary'
    